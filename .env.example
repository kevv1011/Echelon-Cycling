VITE_USE_MOCK_API=true
# Local development default; set true for a browser-only hosted demo:
VITE_HOSTED_DEMO=false
# Set true only after deploying and proxying the account API:
VITE_ACCOUNTS_ENABLED=false
# Set false to persist profiles and cue sheets through FastAPI.
# Leave empty to use Vite's same-origin /api proxy (recommended).
VITE_API_URL=
# Backend: DATABASE_URL=sqlite:///./echelon.db
# PostgreSQL: DATABASE_URL=postgresql+psycopg://user:password@localhost/echelon
# Backend: CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set backend variables in the shell, not as VITE_ variables:
# ECHELON_ACCESS_PASSWORD=<unique password of at least 16 characters>
# Public deployment additionally requires HTTPS and:
# ALLOWED_HOSTS=your-api.example.com
# CORS_ORIGINS=https://your-frontend.example.com
# ECHELON_COOKIE_SECURE=true
# Personal accounts (backend environment, never frontend VITE_ secrets):
# ECHELON_AUTH_MODE=google
# APP_ORIGIN=https://echelon-cycling.vercel.app
# GOOGLE_CLIENT_ID=<Google web application client ID>
# GOOGLE_CLIENT_SECRET=<Google web application client secret>
# OAUTH_STATE_SECRET=<32+ random characters>
# See DEPLOYMENT.md for PostgreSQL and the same-origin /api proxy.
